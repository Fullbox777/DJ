# Nunca compartilhe este token nem publique o arquivo .env.
DISCORD_TOKEN=

# IDs numéricos. Ative o Modo Desenvolvedor no Discord para copiá-los.
GUILD_ID=
VOICE_CHANNEL_ID=

# Entrar na call e iniciar a pasta music ao ligar
AUTO_JOIN=true

# Repetir a pasta music quando a fila acabar
AUTO_LOOP=true

# Embaralhar a playlist ao começar cada ciclo
SHUFFLE_ON_START=false

MUSIC_DIR=music

# Opcional: para ler playlists/álbuns do Spotify, crie um app em developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
